# Image versions for the stack.
#
# These start as floating tags so a fresh kit works anywhere. For a reproducible
# install, run scripts/pin-versions.sh on a server where everything works: it
# rewrites this file with exact image digests (name@sha256:...).
# Keep the pinned copy in the kit; update it on purpose, one service at a time.

GLUETUN_IMAGE=qmcgaw/gluetun:v3
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:latest
TORLINK_IMAGE=calmasacow/torlink-plusplus:latest
JELLYFIN_IMAGE=jellyfin/jellyfin:latest
SEERR_IMAGE=seerr/seerr:latest
RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
